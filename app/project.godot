; Engine configuration file.
config_version=5

[application]

config/name="Lemmix"
config/description="NeoLemmix levels in VR"
config/version="0.1.0"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/bg_color=Color(0.055, 0.027, 0.016, 1)
boot_splash/image="res://Splash/splash.png"

[dotnet]

project/assembly_name="Lemmix"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/foveation_level=2
openxr/foveation_dynamic=false
openxr/foveation_eye_tracked=true
openxr/extensions/render_model=true
shaders/enabled=true
